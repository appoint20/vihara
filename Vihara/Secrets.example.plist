<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Copy this file to Vihara/Secrets.plist and paste your values.
	  Secrets.plist is git-ignored; this template is not.

	  GooglePlacesAPIKey
	    Google Cloud console → APIs & Services → Credentials → Create API key.
	    Enable "Places API (New)". RESTRICT the key to iOS apps and to this
	    bundle id (com.vihara.app) before using it anywhere real — a key inside
	    a shipped app can be extracted, and Places is billed per request.

	  GoogleOAuthClientID
	    Same console → Credentials → Create OAuth client ID → type iOS.
	    Also add the reversed id as a URL scheme under CFBundleURLTypes, or
	    the browser has nowhere to hand the authorisation code back to.

	  Leaving a value as PASTE_… is the same as leaving it out: place search
	  falls back to the curated catalogue, and Google sign-in reports itself as
	  unconfigured rather than failing on tap.
	-->
	<key>GooglePlacesAPIKey</key>
	<string>PASTE_YOUR_PLACES_API_KEY</string>
	<key>GoogleOAuthClientID</key>
	<string>PASTE_YOUR_IOS_OAUTH_CLIENT_ID.apps.googleusercontent.com</string>
</dict>
</plist>
